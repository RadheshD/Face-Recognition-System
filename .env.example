# ── Copy this file to .env and fill in your values ──────────

# Application
APP_NAME=FaceAttend AI
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication — CHANGE THIS IN PRODUCTION!
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-KEY-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Account (created at first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@company.com

# Face Recognition
FACE_RECOGNITION_THRESHOLD=0.55
FACE_RECOGNITION_MODEL=hog

# Anti-Spoofing
ENABLE_ANTI_SPOOFING=true
LIVENESS_SCORE_THRESHOLD=0.45

# Face Encoding Encryption (set ENCRYPT_FACE_ENCODINGS=true for production)
ENCRYPT_FACE_ENCODINGS=false
ENCRYPTION_KEY=

# Camera Processing
FRAME_PROCESS_INTERVAL=2.0
CAMERA_RECONNECT_DELAY=5.0
MAX_SIMULTANEOUS_CAMERAS=5

# Attendance
DUPLICATE_PREVENTION_MINUTES=5
